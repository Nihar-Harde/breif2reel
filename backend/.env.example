APP_NAME=breif2reel Backend
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/breif2reel
TEAM_API_KEY=change-this-team-key
SCHEDULER_SECRET=change-this-scheduler-secret
BACKEND_CORS_ORIGINS=http://localhost:5173
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# HuggingFace (legacy video provider)
HF_SPACE_ID=your-hf-space-id
HF_TOKEN=your-hf-token-here
COLAB_VIDEO_API_URL=your-colab-video-api-url

# Video inference service. Change these values when moving to a replacement
# Azure account or another compatible GPU deployment; application code stays unchanged.
VIDEO_PROVIDER=inference_service
VIDEO_INFERENCE_URL=https://your-video-service.example.com
VIDEO_INFERENCE_API_KEY=change-this-video-service-key
VIDEO_MODEL=ltx-video
VIDEO_GPU_PROFILE=Consumption-GPU-NC8as-T4
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=24
VIDEO_DURATION_SECONDS=10
VIDEO_NUM_FRAMES=241
VIDEO_NUM_STEPS=30
VIDEO_REQUEST_TIMEOUT_SECONDS=900

# Azure Blob Storage
VIDEO_STORAGE_PROVIDER=azure_blob
VIDEO_STORAGE_CONNECTION_STRING=change-this-storage-connection-string
VIDEO_STORAGE_CONTAINER=generated-videos
